    {
      "name": "Quiz",
      "item": [
        {
          "name": "Generate Quiz",
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "raw", "raw": "" },
            "url": {
              "raw": "{{base_url}}/api/child-folders/{{child_folder_id}}/quiz/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "child-folders", "{{child_folder_id}}", "quiz", "generate"]
            },
            "description": "Optional -- uploading content already triggers regeneration automatically. Use this to force a fresh batch on demand even if the quiz is already up to date. Async: publishes a generation request and responds 202 immediately. 409 if the child folder has no summarized content yet -- upload content and wait for hasSummary:true first. Poll \"List Quiz\" afterward."
          },
          "response": []
        },
        {
          "name": "List Quiz",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/child-folders/{{child_folder_id}}/quiz",
              "host": ["{{base_url}}"],
              "path": ["api", "child-folders", "{{child_folder_id}}", "quiz"]
            },
            "description": "correctOption is intentionally omitted -- call Grade Quiz instead of inspecting it client-side."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('listed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    if (Array.isArray(body) && body.length > 0) {",
                  "        pm.collectionVariables.set('question_id', body[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Grade Quiz",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
