    {
      "name": "Conteúdo",
      "item": [
        {
          "name": "Enviar Conteúdo",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "contentType", "type": "text", "value": "PDF" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/child-folders/{{child_folder_id}}/contents",
              "host": ["{{base_url}}"],
              "path": ["api", "child-folders", "{{child_folder_id}}", "contents"]
            },
            "description": "Escolha um arquivo `.pdf` para o campo `file` e defina `contentType` como `PDF`, ou um arquivo `.jpg`/`.jpeg`/`.png` com `contentType` definido como `IMAGE` -- a extensão precisa corresponder ao tipo declarado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('enviado', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('content_id', body.id);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Listar Conteúdo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/child-folders/{{child_folder_id}}/contents",
              "host": ["{{base_url}}"],
              "path": ["api", "child-folders", "{{child_folder_id}}", "contents"]
            },
            "description": "`hasSummary` vira true assim que o pipeline assíncrono de categorização (RabbitMQ + Groq) termina -- nesse momento o quiz, o resumo e os flashcards da pasta filha também se regeneram automaticamente em segundo plano."
          },
          "response": []
        },
