              ]
            },
            "url": {
              "raw": "{{base_url}}/api/child-folders/{{child_folder_id}}/contents",
              "host": ["{{base_url}}"],
              "path": ["api", "child-folders", "{{child_folder_id}}", "contents"]
            },
            "description": "Pick a `.pdf` file for the `file` field and set `contentType` to `PDF`, or a `.jpg`/`.jpeg`/`.png` file with `contentType` set to `IMAGE` -- the extension must match the declared type."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('uploaded', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('content_id', body.id);",
                  "});"
                ]
