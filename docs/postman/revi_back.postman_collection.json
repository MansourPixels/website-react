{
  "info": {
    "name": "revi_back API",
    "description": "REST API for revi_back: folders, content upload/categorization, AI-generated quizzes, folder summaries, flashcards, and a daily streak. Run \"Auth > Register\" first -- it creates a fresh account and stores the token pair in collection variables that every other request reuses automatically, no separate Keycloak call needed. Once an account exists, use \"Auth > Login\" instead of registering again, \"Auth > Refresh\" when the access token expires, and \"Auth > Logout\" to end the session. \"Auth > Get Access Token\" is still there as an alternative (a service-account token via client_credentials, not tied to a specific registered user). Requests are ordered so that running them top-to-bottom threads mother_folder_id / child_folder_id / content_id / question_id through automatically via test scripts.\n\nUploading content (\"Content > Upload Content\") immediately triggers background regeneration of the quiz, folder summary, flashcards, and mind map for that child folder -- \"Quiz > List Quiz\", \"Folder Summary > Get Summary\", \"Flashcards > List Flashcards\", and \"Mind Map > Get Mind Map\" all just read whatever was last generated, no manual refresh needed except \"Quiz > Generate Quiz\" (which forces a fresh batch on demand). Uploading content, reading an existing summary, reading a non-empty flashcard list, and grading a quiz each also count toward the caller's daily streak (\"Streak > Get Streak\") -- doing all four on the same day makes that day gold.\n\nLocal dev: `docker compose up`, then `./mvnw spring-boot:run` (see CLAUDE.md). See docs/API.md for the plain-text reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "b7e2b4a0-2f0a-4c2a-9e8a-3f5a2a2f6a10"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "keycloak_url", "value": "http://localhost:8081", "type": "string" },
    { "key": "realm", "value": "revi", "type": "string" },
    { "key": "client_id", "value": "revi-api-test-client", "type": "string" },
    { "key": "client_secret", "value": "revi-api-test-secret", "type": "string" },
    { "key": "access_token", "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "registered_email", "value": "", "type": "string" },
    { "key": "registered_username", "value": "", "type": "string" },
    { "key": "test_password", "value": "correct-horse-battery", "type": "string" },
    { "key": "mother_folder_id", "value": "", "type": "string" },
    { "key": "child_folder_id", "value": "", "type": "string" },
    { "key": "content_id", "value": "", "type": "string" },
    { "key": "question_id", "value": "", "type": "string" },
    { "key": "study_plan_step_id", "value": "", "type": "string" },
    { "key": "classroom_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{$randomEmail}}\",\n  \"username\": \"{{$randomWord}}{{$randomInt}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Creates a brand-new account and auto-logs in -- the response already contains a working access/refresh token, no separate login call needed. The test script below stores the token pair in `access_token`/`refresh_token`, and the email in `registered_email` so \"Login\" can reuse the same account."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('registered', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', body.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.refreshToken);",
                  "    pm.collectionVariables.set('registered_email', body.email);",
                  "    pm.collectionVariables.set('registered_username', body.username);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{registered_email}}\",\n  \"password\": \"{{test_password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Exchanges the `registered_email` account's credentials (set by \"Register\") for a fresh token pair -- use this instead of \"Register\" once an account already exists, e.g. after logging out or on a later run."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', body.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Exchanges the `refresh_token` collection variable for a fresh token pair. Refresh tokens are single-use: the test script below updates both `access_token` and `refresh_token`, since the one just used stops working after this call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refreshed', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', body.accessToken);",
                  "    pm.collectionVariables.set('refresh_token', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "logout"]
            },
            "description": "Revokes the `refresh_token` collection variable, ending the session. Idempotent -- always 204, whether or not that token was still valid. Run \"Login\" or \"Refresh\" again afterward to keep using the collection."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"person@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "forgot-password"]
            },
            "description": "Always responds 202, whether or not the email has an account -- the response never reveals which emails are registered."
          },
          "response": []
        },
        {
          "name": "Resend Verification Email",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/resend-verification-email",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "resend-verification-email"]
            },
            "description": "Authenticated -- resends the verification email to the caller's own account (resolved from the bearer token)."
          },
          "response": []
        },
        {
          "name": "Get Access Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "client_id", "value": "{{client_id}}", "type": "text" },
                { "key": "client_secret", "value": "{{client_secret}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": ["{{keycloak_url}}"],
              "path": ["realms", "{{realm}}", "protocol", "openid-connect", "token"]
            },
            "description": "Client-credentials grant against the local dev Keycloak realm. The test script below stores the token in the `access_token` collection variable, which every other request's Bearer auth reads from."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('token issued', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('access_token', body.access_token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
