# API publicada (a mesma do deploy na Vercel). Para usar o back-end local,
# troque por http://localhost:8080.
VITE_API_BASE_URL=https://backend-revi.gioiainvestimentos.cloud

# ID público do app no Spotify Developer Dashboard.
# O fluxo é Authorization Code + PKCE: NÃO existe client secret aqui, e nem deve.
VITE_SPOTIFY_CLIENT_ID=

# Cliente OAuth "Web application" no Google Cloud Console.
# A origem JavaScript autorizada precisa incluir http://127.0.0.1:5173 e a URL
# de produção. O client secret é do backend (GOOGLE_CLIENT_SECRET) e NÃO entra
# aqui: tudo que é VITE_* vai para o bundle que o navegador baixa.
VITE_GOOGLE_CLIENT_ID=
# Chave de API (restrita à Picker API) e número do projeto, exigidos pelo
# Google Picker. Sem eles, a importação do Drive some da tela.
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
# true faz o token vir do revi-back, que guarda o refresh token cifrado. É o
# modo de produção: só com ele o servidor publica a entrega na Agenda sem o app
# aberto. Ver GOOGLE.md.
VITE_GOOGLE_BACKEND=true
